{
  "name": "headlessmc-lwjgl",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "additionalVersions": "8,17,21",
      "installGradle": false
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "mounts": [
    "source=headlessmc-lwjgl-gradle,target=/home/vscode/.gradle,type=volume"
  ],
  // Set DEVCONTAINER_USER=root when using rootless Docker.
  "remoteUser": "${localEnv:DEVCONTAINER_USER:vscode}",
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/vscode/.gradle",
    // Gradle toolchains auto-detect the SDKMAN JDKs (8, 17, 21, 25) through this variable.
    "SDKMAN_CANDIDATES_DIR": "/usr/local/sdkman/candidates"
  },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "./gradlew --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
